#!/bin/sh
# stage0 boot hook (OpenRC local.d): take over the console and launch the
# installation menu directly, bypassing the login prompt.

# Guard: this file can leak into an installed stage1 system via setup-disk's
# lbu backup (which copies /etc). stage0-main exists only in stage0, so exit
# cleanly when it is absent rather than exec a missing binary.
[ -x /usr/local/sbin/stage0-main ] || exit 0

export TERM=linux

# Stop the login prompts so the installer owns the console. The `local` service
# runs after getty, so remove the runlevel symlinks and kill any already-running
# getty/agetty to clear the prompt.
for s in /etc/runlevels/default/getty.* /etc/runlevels/default/agetty.*; do
    [ -e "$s" ] && rm -f "$s"
done
killall getty 2>/dev/null
killall agetty 2>/dev/null

# Launch the installer on every available console (VGA tty1 and serial ttyS0),
# so it is visible whether the operator is attached via VNC or IPMI serial.
# Terminal type is auto-detected by device class:
#   - ttyN (VGA virtual console) -> "linux". This is the kernel's own vt
#     terminal (vgacon), identical whether viewed through a real VGA monitor or
#     a VNC/noVNC framebuffer. It is the one TERM dialog renders correctly on;
#     "xterm"/"vt100" left the menu undrawn until a keypress.
#   - ttyS*/ttyAMA*/hvc* (serial) -> "vt100", the common denominator for IPMI
#     serial-over-LAN (and Proxmox's xterm.js serial, which is vt100-compatible).
for tty in tty1 ttyS0 ttyAMA0 hvc0; do
    [ -c "/dev/$tty" ] || continue
    case "$tty" in
        tty[0-9]*) _term=linux ;;
        *) _term=vt100 ;;
    esac
    (
        # Ensure a non-zero terminal size before the menu runs. A 0x0 window
        # size (seen on VGA consoles under noVNC) makes dialog draw an empty
        # box that only paints after the first keypress. `resize` asks the
        # terminal for its real size (DSR cursor-position query on stderr, the
        # reply read from stdin) and prints COLUMNS=..;LINES=.. on stdout; apply
        # it, then fall back to a sane default when the console reports none.
        _rsz=$(timeout 5 resize < "/dev/$tty" 2> "/dev/$tty" 2>/dev/null)
        eval "$_rsz" 2>/dev/null || true
        case "$COLUMNS" in ''|0|*[!0-9]*) COLUMNS=80 ;; esac
        case "$LINES"   in ''|0|*[!0-9]*) LINES=24  ;; esac
        export COLUMNS LINES
        stty rows "$LINES" cols "$COLUMNS" < "/dev/$tty" 2>/dev/null || true
        TERM=$_term exec /usr/local/sbin/stage0-main < "/dev/$tty" > "/dev/$tty" 2>&1
    ) &
done

wait
