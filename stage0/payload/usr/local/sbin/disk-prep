#!/bin/sh
# disk-prep — Disk Provisioner (stage0-netboot-image, task 2.3)
#
# Makes the operator-confirmed target disk bootable: partitions it, installs a
# grub bootloader for the detected firmware mode, and installs the minimal base
# OS — all via the standard Alpine disk install (`setup-disk -m sys`).
#
# The destructive work is gated behind two layers:
#   1. A pure, testable core (`disk_prep_plan`) that resolves the by-id path to
#      a real device, guards against wrong-disk writes (requirement 6.3), and
#      emits the shell commands — it never executes anything.
#   2. A thin wrapper (`disk_prep_run`) that executes those commands, or prints
#      them only when DRY_RUN=1.
#
# Contract:
#
#     disk_prep_plan <disk_id> <firmware> [by_id_dir]
#
#   <disk_id>    the confirmed targetDisk.id — a /dev/disk/by-id/... path (or,
#                under test, a symlink inside the supplied by_id_dir).
#   <firmware>   "bios" or "uefi".
#   <by_id_dir>  optional; defaults to /dev/disk/by-id (test seam).
#
# On success it emits on stdout the commands to run, one per line:
#
#   bios:  yes | BOOTLOADER=grub setup-disk -m sys /dev/<dev>
#   uefi:  yes | USE_EFI=1 BOOTLOADER=grub setup-disk -m sys /dev/<dev>
#
# `yes` answers setup-disk's "Erase the above disk(s)?" confirmation (it reads
# stdin; a closed pipe would default to "n" and abort). `BOOTLOADER=grub`
# selects grub (requirement 6.2); setup-disk installs the firmware-correct grub
# target itself (i386-pc for BIOS, x86_64-efi when USE_EFI=1). On any guard
# failure it emits nothing on stdout and returns non-zero.
#
# All functions are POSIX sh (busybox ash compatible); no bashisms.

DISK_PREP_DISK_LIB=${DISK_PREP_DISK_LIB:-/usr/local/sbin/lib/disk.sh}

# Reuse the stable-id resolution helper (disk.sh -> disk_resolve_by_id).
. "$DISK_PREP_DISK_LIB"

# ---------------------------------------------------------------------------
# Core: command generation + wrong-disk guard (pure; never executes)
# ---------------------------------------------------------------------------

# disk_prep_plan <disk_id> <firmware> [by_id_dir]
# Emit the `setup-disk -m sys` + grub-install commands for the pinned disk, or
# nothing + non-zero when the disk cannot be pinned to its by-id target.
disk_prep_plan() {
    _disk_id=${1:-}
    _firmware=${2:-}
    _by_id_dir=${3:-/dev/disk/by-id}

    # (1) A target disk id is mandatory (requirement 6.3 — never guess a disk).
    [ -n "$_disk_id" ] || {
        echo "disk-prep: target disk id is required" >&2
        return 1
    }

    # (2) Resolve the target to a device name. A symlink (a /dev/disk/by-id
    #     entry, for disks with a serial) is resolved + round-trip guarded; a
    #     plain /dev/<name> path (disks with no by-id symlink) is used directly.
    _link_target=$(readlink "$_disk_id" 2>/dev/null)
    if [ -n "$_link_target" ]; then
        _dev=${_link_target##*/}
        [ -n "$_dev" ] || {
            echo "disk-prep: symlink target resolves to no device: $_disk_id" >&2
            return 1
        }

        # (3) Wrong-disk guard (requirement 6.3): the resolved device must
        #     round-trip to exactly this by-id path.
        _resolved=$(disk_resolve_by_id "$_dev" "$_by_id_dir" 2>/dev/null) || {
            echo "disk-prep: device $_dev has no stable by-id entry; refusing" >&2
            return 1
        }
        [ "$_resolved" = "$_disk_id" ] || {
            echo "disk-prep: resolved device [$_resolved] is not the expected by-id target [$_disk_id]; refusing" >&2
            return 1
        }
    else
        case "$_disk_id" in
            /dev/*) _dev=${_disk_id#/dev/} ;;
            *) echo "disk-prep: invalid target disk id: $_disk_id" >&2; return 1 ;;
        esac
    fi

    # (4) Firmware mode -> bootloader selection (requirement 6.2). Pipe `yes`
    # into setup-disk so its "Erase the above disk(s)?" prompt is auto-confirmed
    # (a closed stdin defaults to "n" and aborts). setup-disk's own grub install
    # picks the firmware-correct target.
    _real_dev="/dev/$_dev"
    case "$_firmware" in
        bios)
            printf 'yes | BOOTLOADER=grub setup-disk -m sys %s\n' "$_real_dev"
            ;;
        uefi)
            printf 'yes | USE_EFI=1 BOOTLOADER=grub setup-disk -m sys %s\n' "$_real_dev"
            ;;
        *)
            echo "disk-prep: unsupported firmware mode [$_firmware] (expected bios|uefi)" >&2
            return 1
            ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Thin wrapper: execute (or, with DRY_RUN=1, only print) the generated plan
# ---------------------------------------------------------------------------

# disk_prep_remount <disk_id>
# setup-disk -m sys unmounts the installed root before it returns, so the
# stage1-install injection into the sysroot (/mnt) would otherwise write into
# the unmounted directory and be lost on reboot. Re-mount the root partition
# (the last ext4 partition on the target disk) to /mnt. Returns 0 on success.
disk_prep_remount() {
    _disk_id=${1:-}
    [ -n "$_disk_id" ] || return 1

    _link_target=$(readlink "$_disk_id" 2>/dev/null)
    if [ -n "$_link_target" ]; then
        _dev=${_link_target##*/}
    else
        case "$_disk_id" in
            /dev/*) _dev=${_disk_id#/dev/} ;;
            *) return 1 ;;
        esac
    fi

    _root=$(lsblk -rno NAME,FSTYPE "/dev/$_dev" 2>/dev/null \
        | awk '$2=="ext4"{print $1}' | tail -1)
    [ -n "$_root" ] || {
        echo "disk-prep: no ext4 root partition found on /dev/$_dev" >&2
        return 1
    }
    mount "/dev/$_root" /mnt
}

# disk_prep_run <disk_id> <firmware> [by_id_dir]
# Plan, print, then execute — unless DRY_RUN=1, which prints only. After a real
# run, re-mount the installed root so the next step (stage1-install) writes to
# the disk rather than the unmounted sysroot directory.
disk_prep_run() {
    _plan=$(disk_prep_plan "$@") || return $?
    printf '%s\n' "$_plan"
    if [ "${DRY_RUN:-0}" = 1 ]; then
        return 0
    fi
    printf '%s\n' "$_plan" | sh -e || return $?
    disk_prep_remount "$1"
}

# Run as a command only when invoked as `disk-prep` (not when sourced by a test).
case "${0##*/}" in
    disk-prep) disk_prep_run "$@" ;;
esac
